      },
      {
        "name": "lokasi_penyimpanan",
        "description": "Lokasi penyimpanan",
        "encoder_classes": ["Pembeku", "Pendingin", "Suhu Ruang"]
      },
      {
        "name": "label",
        "description": "Kondisi fisik item",
