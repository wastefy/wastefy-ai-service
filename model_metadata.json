          "Apel",
          "Cabe",
          "Jeruk",
          "Kentang",
          "Mangga",
          "Pisang",
          "Timun",
          "Tomat",
          "Wortel"
        ]
      },
      {
        "name": "jenis_item",
        "description": "Jenis item",
